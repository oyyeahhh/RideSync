# Copy this file to .env and fill in your key.
# Do NOT commit .env to git.
# Two Google Maps keys, because one cannot be restricted for both jobs.
#
# Browser key: rendered into the page for the map. In Google Cloud, restrict it
# by HTTP referrer to your domain (carpoolsync.com/*) and allow ONLY the Maps
# JavaScript API. Every parent can read this one out of the page source, which
# is fine once it is restricted.
GOOGLE_MAPS_BROWSER_KEY=paste_your_referrer_restricted_key_here
#
# Server key: geocoding and route calls. Allow ONLY the Geocoding API and the
# Routes API. This one can spend money, so it must never reach a browser.
GOOGLE_MAPS_SERVER_KEY=paste_your_server_key_here
#
# Deprecated. Both of the above fall back to this if they are unset, so an
# existing single-key setup keeps working. Remove it once the two are set.
# GOOGLE_MAPS_API_KEY=
